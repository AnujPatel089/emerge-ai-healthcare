# ==========================================
# EmergeAI Healthcare - Environment Config
# ==========================================

# =========================
# Backend Configuration
# =========================
DATABASE_URL=postgresql://postgres:password@localhost:5432/emergeai

SECRET_KEY=change-this-to-a-long-random-production-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=60

HOST=0.0.0.0
PORT=8000
RELOAD=false

# =========================
# CORS Configuration
# =========================
# Local Development
# http://localhost:8501
# http://127.0.0.1:8501
#
# Production Example
# https://emergeai-frontend.onrender.com
# https://your-streamlit-app.streamlit.app
#
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# =========================
# Frontend Configuration
# =========================
# Local backend
API_URL=http://127.0.0.1:8000

# Production Example
# API_URL=https://your-backend-url.com

# =========================
# Email Configuration (Optional)
# =========================
SMTP_EMAIL=

SMTP_PASSWORD=

SMTP_SERVER=smtp.gmail.com

SMTP_PORT=465

SMTP_USE_SSL=true

SMTP_TIMEOUT=60

# =========================
# AI / Model Settings (Optional)
# =========================
MODEL_PATH=models/triage_xgboost_balanced.pkl

LABEL_ENCODER_PATH=models/esi_label_encoder.pkl

SHAP_OUTPUT_DIR=shap_outputs/

REPORT_OUTPUT_DIR=reports/

# =========================
# Logging
# =========================
LOG_LEVEL=INFO

# =========================
# Deployment Environment
# =========================
ENVIRONMENT=development